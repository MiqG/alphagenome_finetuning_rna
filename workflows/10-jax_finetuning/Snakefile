"""
JAX finetuning workflow (alphagenome_ft): probing + LoRA reproduction of the
PyTorch paper runs, plus evaluation.

Cross-checks the alphagenome-pytorch splicing fine-tuning results against a
JAX/alphagenome_research-based finetuning path, using the sibling
alphagenome_ft package (splice-finetuning branch,
/users/diasfrazer/manglada/repositories/alphagenome_ft).

rules/finetune.smk trains all 4 modalities jointly (rna_seq + splice_site +
splice_usage + splice_junctions), matching workflows/05-full_finetuning/
Snakefile's runs as closely as the JAX/alphagenome_ft stack allows, and
behaves exactly as if finetuning were run locally on this cluster.

rules/evaluate.smk evaluates finetuned checkpoints on the FOLD_1 test set —
but against results/xinming/alphagenome_finetuning_downstream_2026-08-31/,
a results package from xinming's rerun of this same finetuning on their own
cluster (ours was too slow), not against rules/finetune.smk's own output.
This lets evaluation run today without waiting on a local finetuning run to
complete.

Run with:
    snakemake -s workflows/10-jax_finetuning/Snakefile --use-conda [-n]

To evaluate only (skip local finetuning entirely, since evaluation reads
xinming's checkpoints):
    snakemake -s workflows/10-jax_finetuning/Snakefile --use-conda \\
        results/evaluation/alphagenome_ft/full/{run_name}/{subset}/metrics.parquet

As with other GPU workflows in this repo, submit the actual (non-dry-run)
run via SLURM rather than on the login node:
    ./src/scripts/submit_snakemake_slurm.sh \\
        "snakemake -s workflows/10-jax_finetuning/Snakefile --use-conda -j 4"
"""

configfile: "config/config.yaml"

include: "rules/finetune.smk"
include: "rules/evaluate.smk"
include: "rules/paper.smk"

rule all:
    input:
        FINETUNE_TARGETS,
        EVAL_TARGETS,
        PAPER_JAX_TARGETS,
